  "qualitative_insights": [
    {
      "type": "pricing_gap",
      "severity": "high",
      "title": "March AM pays the #2 lowest effective depositary fee of 26 Inversis clients",
      "body": "March AM's AUM-weighted depositary fee is 3.82 bps — 3.7 bps below the Inversis book median of 7.5 bps. It is ranked #1 out of 26 gestoras by AUM and #2 lowest by weighted fee rate. Andbank WM, the closest peer by AUM (€3.4B), pays 6.88 bps — 3.1 bps more than March AM."
    },
    {
      "type": "zero_fee_drag",
      "severity": "high",
      "title": "31% of March AM AUM carries zero depositary fee",
      "body": "An estimated €1566M of March AM's €5.1B AUM under Inversis custody is charged 0 bps — almost certainly reflecting an intragroup arrangement (largest: MARCH PAGARES and MARCH RENTA FIJA 1-3 AÑOS). This single item foregoes c.€1173K/yr at the Inversis book median (7.5 bps)."
    },
    {
      "type": "revenue_opportunity",
      "severity": "medium",
      "title": "Phased fee normalisation could add €783K–€1560K/yr in additional depositary revenue",
      "body": "Raising March AM to Andbank parity (6.88 bps) would generate €3509K vs current €1949K — an uplift of €1560K (+80%). A phased approach (Scenario A first, then B) over 18–24 months minimises commercial disruption and is below the threshold that would trigger a cost/benefit review by March AM."
    },
    {
      "type": "switching_risk",
      "severity": "low",
      "title": "Switching risk is low: operational friction protects Inversis's book",
      "body": "Moving 45 share classes across 23 funds requires CNMV notification per class, fund prospectus updates, shareholder communications, and systems migration — typically a 12-month process costing €250-350K. A competitor would need to undercut by >100K/yr to make the switch rational for March AM. No major Spanish depositary currently offers a credible alternative at materially lower cost for a mandate of this complexity and mix."
    }
  ],
